---
const { question, options } = Astro.props;

interface Option {
  label: string;
  value: string;
  correct: boolean;
}
---

<article class="question">
	<p class="question__text">{question}</p>
  <ul class="question__options" role="list">
    {
      options.map((option: Option) => (
        <li
          class:list={[
            "question__option",
            { "question__option--correct": option.correct },
          ]}
        >
          <span class="question__icon" aria-hidden="true">
            {option.correct ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
              </svg>
            )}
          </span>
          <span class="question__label">{option.label}</span>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .question {
    margin-block: 1.25rem;
  }

  .question__text {
    font-size: 1rem;
    font-weight: var(--sl-font-weight-semibold, 600);
    line-height: var(--sl-line-height, 1.6);
    margin: 0 0 0.75rem;
  }

  .question__options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .question__option {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    /* color: var(--sl-color-gray-6, #334155); */
    line-height: 1.5;
  }

  .question__icon {
    flex-shrink: 0;
    display: flex;
    margin-top: 0.15em;
    color: var(--sl-color-gray-4, #94a3b8);
  }

  .question__label {
    flex: 1;
  }

  .question__option--correct {
    color: var(--sl-color-green-high, #15803d);
  }

  .question__option--correct .question__icon {
    color: var(--sl-color-green-high, #15803d);
  }
</style>
